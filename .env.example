# JobTrace Proxy 环境变量示例（复制为真实环境变量，在 EdgeOne Pages 控制台配置）
# ⚠️ 本文件只含占位值，绝不提交真实 Key。

# [1] Demo Access Guard：Tester/Web Demo 调用所需的访问令牌（自己生成随机串）
DEMO_TOKEN=change-me

# [4] LLM 转发（OpenAI-compatible）：真实 Key 只在控制台配置，不进仓库
# ---- 文本模型（纯文本请求用，推荐 DeepSeek）----
LLM_API_KEY=sk-deepseek-xxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ---- 视觉模型（含截图请求用，需支持图片输入，如智谱 glm-4.6v）----
# 未配置视觉三件套时，截图请求回退到文本配置
LLM_VISION_API_KEY=sk-zhipu-xxx
LLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_VISION_MODEL=glm-4.6v

# [2] Rate Limit：每 token 每小时窗口的最大调用次数
RATE_LIMIT_PER_WINDOW=20

# [3] Daily Budget Guard：单日估算成本上限（USD），超限即整体停止
DAILY_BUDGET_USD=1

# 单次调用成本估算（用于预算守卫）：文本 / 含截图（vision）
COST_PER_CALL_USD=0.005
COST_PER_VISION_CALL_USD=0.02

# KV 命名空间绑定名：在 EdgeOne Pages 项目「设置 → 绑定 KV」中创建命名空间，
# 把「环境变量名」填成 KV_NAMESPACE 的值（即此处填的名字，例如 JOBTRACE_KV）。
KV_NAMESPACE=JOBTRACE_KV

# 守卫计数存储：kv（默认，正式，需 KV 审批通过）/ memory（临时降级，内存计数，
# 多节点不共享、重启清零，仅限 KV 未开通时使用；每次响应头带 x-guard-storage 标记）。
GUARD_STORAGE=kv
